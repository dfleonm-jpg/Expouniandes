rules_version = '2';

// ============================================================
// Reglas de seguridad de Firestore para Sereno.
//
// Principios:
//  - El progreso del usuario (users/{uid} y sus subcolecciones) es
//    PRIVADO: solo su dueño lo lee y escribe.
//  - El ranking (leaderboard) es de lectura pública, pero cada quien
//    solo escribe SU documento y con una FORMA validada (sin inyectar
//    campos raros ni tipos incorrectos).
//  - Las métricas globales (metrics/global) son de lectura pública y
//    cualquier usuario autenticado puede sumar, pero las escrituras
//    deben ser INCREMENTOS no negativos (no se pueden fijar valores
//    arbitrarios ni poner negativos).
//
// Nota: Firestore no puede verificar criptográficamente que el XP del
// cliente sea "real"; estas reglas endurecen la forma y los límites, que
// es lo máximo alcanzable sin Cloud Functions. Para un ranking
// totalmente a prueba de trampas, el cálculo de XP debería moverse a una
// Cloud Function con permisos de administrador.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Progreso del usuario (privado) ----
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Subcolecciones (p. ej. chats): solo el dueño.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Ranking (lectura pública, escritura validada del propio doc) ----
    match /leaderboard/{uid} {
      allow read: if true;

      allow write: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 100000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000
        && request.resource.data.updatedAt is int;
    }

    // ---- Recursos compartidos por código corto (grupos de estudio) ----
    // Lectura pública (cualquiera con el código puede traerlo). Creación por
    // usuarios autenticados con forma validada y tamaño acotado. No se permite
    // editar/borrar (los códigos son inmutables una vez creados).
    match /shares/{code} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.type in ['summary', 'quiz', 'flashcards', 'plan']
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120;
      allow update, delete: if false;
    }

    // ---- Blog (posts, comentarios y reacciones) ----
    // Política: lectura solo para usuarios autenticados (la app exige login y
    // así no se exponen nombres/fotos a cualquiera con el ID del proyecto).
    // Escritura: solo el autor, con forma, tipos y longitudes validadas.
    // Los totales de Like/Dislike/comentarios NO se almacenan: se calculan
    // contando documentos, así no hay contadores que manipular.

    // Campos de autoría compartidos por posts y comentarios.
    function validAuthor(d) {
      return d.authorUid is string
        && d.authorName is string && d.authorName.size() >= 1 && d.authorName.size() <= 60
        && (d.authorPhoto == null || (d.authorPhoto is string && d.authorPhoto.size() <= 2048));
    }
    function validPostBody(d) {
      return d.title is string && d.title.size() >= 1 && d.title.size() <= 120
        && d.content is string && d.content.size() >= 1 && d.content.size() <= 5000;
    }
    function validCommentBody(d) {
      return d.content is string && d.content.size() >= 1 && d.content.size() <= 1000;
    }

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(
             ['authorUid','authorName','authorPhoto','title','content','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(
             ['authorUid','authorName','authorPhoto','title','content','createdAt','updatedAt'])
        && request.resource.data.authorUid == request.auth.uid
        && validAuthor(request.resource.data)
        && validPostBody(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Solo el autor edita, y únicamente título, contenido y updatedAt
      // (no se puede cambiar autoría ni fecha de creación).
      allow update: if signedIn()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title','content','updatedAt'])
        && validPostBody(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly(
               ['authorUid','authorName','authorPhoto','content','createdAt','updatedAt'])
          && request.resource.data.keys().hasAll(
               ['authorUid','authorName','authorPhoto','content','createdAt','updatedAt'])
          && request.resource.data.authorUid == request.auth.uid
          && validAuthor(request.resource.data)
          && validCommentBody(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['content','updatedAt'])
          && validCommentBody(request.resource.data)
          && request.resource.data.updatedAt == request.time;

        allow delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }

      // Una reacción por usuario: el ID del documento ES el uid.
      match /reactions/{uid} {
        allow read: if signedIn();

        allow create, update: if isOwner(uid)
          && exists(/databases/$(database)/documents/posts/$(postId))
          && request.resource.data.keys().hasOnly(['uid','type','updatedAt'])
          && request.resource.data.keys().hasAll(['uid','type','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['like', 'dislike']
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(uid);
      }
    }

    // ---- Métricas globales (lectura pública, solo incrementos) ----
    match /metrics/{doc} {
      allow read: if true;

      // Permite crear el documento la primera vez con valores no negativos.
      allow create: if signedIn()
        && onlyNonNegativeNumbers(request.resource.data);

      // En updates, exige que cada campo numérico sea >= su valor anterior
      // (solo se puede sumar, nunca bajar ni fijar a cero).
      allow update: if signedIn()
        && onlyNonNegativeNumbers(request.resource.data)
        && isIncrementOnly();
    }

    function onlyNonNegativeNumbers(data) {
      return data.keys().hasOnly(['focusMinutes','quizzes','questions','summaries','flashcards'])
        && (!('focusMinutes' in data) || (data.focusMinutes is number && data.focusMinutes >= 0))
        && (!('quizzes' in data)      || (data.quizzes is number && data.quizzes >= 0))
        && (!('questions' in data)    || (data.questions is number && data.questions >= 0))
        && (!('summaries' in data)    || (data.summaries is number && data.summaries >= 0))
        && (!('flashcards' in data)   || (data.flashcards is number && data.flashcards >= 0));
    }

    function fieldGrows(name) {
      return !(name in request.resource.data)
        || !(name in resource.data)
        || request.resource.data[name] >= resource.data[name];
    }
    function isIncrementOnly() {
      return fieldGrows('focusMinutes')
        && fieldGrows('quizzes')
        && fieldGrows('questions')
        && fieldGrows('summaries')
        && fieldGrows('flashcards');
    }
  }
}
